BOT_TOKEN=
DATABASE_PATH=data/restaurant_menu_bot.sqlite3
DEBUG=false

# local для разработки, minio для сервера
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/photos

# Заполняется только если STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=restaurant-menu
MINIO_SECRET_KEY=change-this-password
MINIO_BUCKET=dish-photos
MINIO_SECURE=false
